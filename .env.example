# OptiQueue Production Environment Variables
# Copy this to .env and fill in real values
# .env is .gitignored — never commit real secrets

# Database
DB_URL=jdbc:postgresql://postgres:5432/optiqueue
DB_USER=optiqueue
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# Security
# Comma-separated for multiple keys (zero-downtime rotation)
API_KEYS=CHANGE_ME_RANDOM_32_CHAR_HEX

# Worker
WORKER_POOL_SIZE=4
WORKER_QUEUE_CAP=100
WORKER_ID=worker-1

# Scheduler / Retry
SCHEDULER_POLL_MS=2000
RETRY_MAX=5
RETRY_DELAY_MS=1000
RETRY_SCAN_MS=5000
DLQ_SCAN_MS=30000

# Heartbeat / Failover
HEARTBEAT_MS=5000
HEARTBEAT_TTL_MS=15000
FAILOVER_SCAN_MS=30000

# Server
SERVER_PORT=8080
